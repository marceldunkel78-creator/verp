# WICHTIG: hier 127.0.0.1 statt "localhost".
#
# "localhost" loest Windows zu ::1 (IPv6) auf. Django lauscht aber nur auf
# 127.0.0.1 (IPv4). Das ::1-Paket geht dann ueber das Tailscale-Interface
# (MTU 1280) und laeuft in einen Timeout von ca. 2 Sekunden - bei JEDEM
# API-Aufruf, unabhaengig von Endpunkt und Antwortgroesse.
#
# Gemessen am 02.10.2026:
#   http://localhost:8000   ~2070 ms
#   http://127.0.0.1:8000    ~70 ms
REACT_APP_API_URL=http://127.0.0.1:8000/api
HOST=0.0.0.0
DANGEROUSLY_DISABLE_HOST_CHECK=true
