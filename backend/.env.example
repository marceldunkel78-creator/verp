# VERP Environment Configuration
# Copy this file to .env and adjust the values

# Django Settings
SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cookie-/Sicherheits-Flags fuer Produktion ueber PLAIN HTTP (Intranet):
# Ohne diese Zeilen ist bei DJANGO_DEBUG=False die Anmeldung kaputt
# (401 "Anmeldedaten fehlen." / 400 refresh "Dieses Feld ist erforderlich.",
# weil der Browser die als "secure" markierten JWT-Cookies auf http:// wirft).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Optional: JWT-Cookie "secure"-Flag erzwingen. Standard ist AUTOMATISCH
# (nur bei echtem HTTPS gesetzt). Hinter TLS-terminierendem Proxy auf True.
# JWT_COOKIE_SECURE=True

# Database
DB_NAME=verp_db
DB_USER=verp_user
DB_PASSWORD=verp_password
DB_HOST=localhost
DB_PORT=5432

# Media Storage - Absoluter Pfad zum externen Medienordner
# Beispiel Windows local: C:/VERP-Media
# Beispiel Windows UNC (fileserver): \\fileserver\verp_media
# Beispiel Linux local: /var/verp-media (or /mnt/verp_media when a mount is used)
# Wenn Docker verwendet wird, mounten Sie das Host-Verzeichnis in den Container und setzen MEDIA_ROOT entsprechend
# Beispiel docker-compose (host path -> container path):
#   volumes:
#     - /mnt/verp_media:/app/media
#   environment:
#     - MEDIA_ROOT=/app/media
MEDIA_ROOT=C:/VERP-Media

# Legacy Procurement Order Import - CSV and PDF/DOCX source directory
# Windows production example: C:/VERP/Datenvorlagen
# The directory must contain bestlist.csv; documents are optional.
LEGACY_PROCUREMENT_DATA_DIR=C:/VERP/Datenvorlagen

# Automatischer Excel-Lagerabgleich (sync_inventory_from_excel)
# Verzeichnis mit den Excel-/CSV-Lagerlisten (Warengruppen-/Herstellerlisten).
# Windows-Produktion Beispiel (UNC): \\\\fileserver\\Lager\\Warenlager
# Ohne diesen Wert wird ../Datenvorlagen relativ zum Backend verwendet.
INVENTORY_EXCEL_DIR=
# glob-Pattern fuer die zu verarbeitenden Dateien (Default: *.xlsx)
# Die Lagerlisten liegen aktuell ueberwiegend im ALTEN .xls-Format, daher
# "*.xls*" verwenden - das erfasst .xls, .xlsx und .xlsm.
INVENTORY_EXCEL_PATTERN=*.xls*
# Optionales eigenes Spalten-Mapping (JSON). Default: backend/inventory/excel_mapping.json
# INVENTORY_EXCEL_MAPPING=

# Ordner, die vom Import ausgeschlossen werden (kommasepariert).
# Wirkt auch fuer Unterordner: INVENTORY_EXCEL_EXCLUDE_DIRS=Archiv,_alt,Backup
# Beispielstruktur:
#   Lager\Kamera.xlsx          <- importiert
#   Lager\Archiv\Laser.xls     <- uebersprungen
#   Lager\2023\Laser.xls       <- uebersprungen
# INVENTORY_EXCEL_EXCLUDE_DIRS=

# Optional: Base URL für Media-Dateien in Produktion
# Beispiel: MEDIA_BASE_URL=http://verp.intern.local
# Falls nicht gesetzt, wird die URL aus dem Request generiert
# MEDIA_BASE_URL=

# JWT Token-Laufzeiten
# ACCESS_TOKEN_HOURS: Gültigkeit des Access-Tokens in Stunden (Standard: 8)
# REFRESH_TOKEN_DAYS: Wie lange man eingeloggt bleibt ohne erneuten Login (Standard: 30 Tage)
# ACCESS_TOKEN_HOURS=8
# REFRESH_TOKEN_DAYS=30

# Sicherheit: Wenn die Produktion OHNE HTTPS läuft (z.B. internes Netzwerk),
# müssen diese auf False gesetzt werden, damit Cookies funktionieren:
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# SECURE_SSL_REDIRECT=False

# Optional: Übersetzungs-API Einstellungen (für automatische DE->EN Übersetzungen)
# Beispiel für LibreTranslate (öffentlicher Dienst):
# TRANSLATION_API_URL=https://libretranslate.com/translate
# Wenn ein API-Key benötigt wird, setzen Sie ihn hier:
# TRANSLATION_API_KEY=
# Hinweis: Verwenden Sie einen eigenen Übersetzungsdienst in Produktion oder ein API-Key-geschütztes Endpoint.
